NODE_ENV=development
PORT=4000

# Required for persistent data and admin sign-in in production.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DB=portfolio
JWT_SECRET=<generate-a-long-random-secret>

# Required to bootstrap the first admin account when none exists.
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD_HASH=<bcrypt-hash>
# Alternatively, use ADMIN_PASSWORD instead of ADMIN_PASSWORD_HASH.

# Required for email verification, email-code sign-in, and password recovery.
EMAIL_USER=<smtp-username>
EMAIL_PASS=<smtp-password-or-app-password>
# Optional sender address; defaults to EMAIL_USER.
# EMAIL_FROM=<verified-sender-address>
# Optional custom SMTP settings; Gmail is used when EMAIL_HOST is unset.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Required only for image and CV uploads.
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<api-secret>

# Set to the exact frontend origin(s) in production, comma-separated.
# FRONTEND_ORIGINS=https://your-frontend.example
# Optional: strict, lax, or none. Production defaults to none.
# ADMIN_COOKIE_SAME_SITE=none
