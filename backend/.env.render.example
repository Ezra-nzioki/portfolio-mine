# Copy these keys into Render's backend service Environment settings.
# Replace every <...> placeholder with your own value; never commit real secrets.
# Do not set PORT: Render provides it.

NODE_ENV=production

# MongoDB is required for persistence and admin sign-in.
# URL-encode special characters in the database username/password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
MONGODB_DB=portfolio
# Keep this value stable across deployments so existing login cookies remain valid.
JWT_SECRET=<unique-long-random-secret>

# Used only when creating the first admin account.
# Use ADMIN_PASSWORD_HASH instead if you already generated a bcrypt hash.
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<strong-admin-password>

# Resend test sender: delivery is restricted to your Resend account email.
# Verify a domain in Resend to send to other recipients.
EMAIL_PROVIDER=resend
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=onboarding@resend.dev

# Required for image and CV uploads.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Exact frontend origin, without a trailing slash.
FRONTEND_ORIGINS=https://<your-frontend-domain>
ADMIN_COOKIE_SAME_SITE=none
